post_install() {
  cat <<'MSG'
==> yowu-headset: enable the daemon for your user (not as root):
      systemctl --user enable --now yowu-headsetd
==> Unplug and replug the dongle once so the new udev rule applies.
==> Configuration: /etc/yowu-headset/headsetd.conf (system-wide) or
    ~/.config/yowu-headset/headsetd.conf (per user, takes precedence).
    For LED control (yowu-led, [led] on_connect) install python-bleak.
MSG
}

post_upgrade() {
  cat <<'MSG'
==> yowu-headset: restart the daemon to pick up the new version:
      systemctl --user restart yowu-headsetd
MSG
}

pre_remove() {
  cat <<'MSG'
==> yowu-headset: disable the daemon for each user that enabled it:
      systemctl --user disable --now yowu-headsetd
MSG
}
